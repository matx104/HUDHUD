{
  "inputs": [
    {
      "type": "promptString",
      "id": "access-client-id",
      "description": "HUDHUD live Critic: Cloudflare Access service token, client ID (~/.config/hudhud/access-token.json)"
    },
    {
      "type": "promptString",
      "id": "access-client-secret",
      "password": true,
      "description": "HUDHUD live Critic: Cloudflare Access service token, client secret"
    }
  ],
  "servers": {
    "azure": {
      "type": "stdio",
      "command": "${workspaceFolder}/scripts/azure-mcp"
    },
    "hudhud-critic": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "court.mcp_server"
      ]
    },
    "hudhud-critic-live": {
      "type": "http",
      "url": "https://mcp.hudhud.com.pk/",
      "headers": {
        "CF-Access-Client-Id": "${input:access-client-id}",
        "CF-Access-Client-Secret": "${input:access-client-secret}"
      }
    }
  }
}
