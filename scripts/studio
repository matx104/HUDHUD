#!/usr/bin/env sh
# The studio on this machine, narrated by the Foundry models, with audit and traces on.
#   scripts/studio            # then open http://localhost:8080
here="$(cd "$(dirname "$0")/.." && pwd)"
. "$here/scripts/live-env"
exec "$here/.venv/bin/uvicorn" court.server:app --host 127.0.0.1 --port "${PORT:-8080}"
