# HUDHUD's settings. Copy this file to .env (gitignored) and fill in what you use.
#
# Nothing here is needed to try HUDHUD. `make test` and `make studio-offline` run with no Azure,
# no keys and no .env, and https://hudhud.com.pk/#/screens replays the live studio in the browser.
#
# To narrate with your own Microsoft Foundry models: install the Azure extras with
# `.venv/bin/pip install -e "apps/api[foundry,audit,telemetry]"`, fill in the Foundry lines, sign
# in with `az login`, then `make studio` and open http://localhost:8091. scripts/live-env reads this
# file first: what it sets wins, and a service left empty stays off. There are no API keys: every
# service is reached with Microsoft Entra ID (your az login), so nothing secret belongs here except
# the owner-only line at the end. docs/azure.md sets up each service.
#
# The file is read by sh: quote any value with spaces or a ;.

# --- Signing in -----------------------------------------------------------------------------------
# Your own az login (left unset, the scripts use the owner's separate CLI profile).
AZURE_CONFIG_DIR="$HOME/.azure"
# Your tenant; empty uses the az login's default.
AZURE_TENANT_ID=

# --- Microsoft Foundry: the Narrator (needed for `make studio`) -----------------------------------
# The project endpoint, from the project's overview in the Foundry portal.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Deployment names, primary first: the second takes over when the first fails (ADR 0005).
FOUNDRY_MODELS=gpt-4.1-mini,gpt-5-mini

# --- Optional: each stays off while empty ---------------------------------------------------------
# The audit trail of every claim, verdict and cue: Azure Cosmos DB for NoSQL, database `hudhud`,
# container `audit`, partition key /matchId.
COSMOS_ENDPOINT=
# Traces of every match and alert into Application Insights (keep the quotes: the string has ;).
APPLICATIONINSIGHTS_CONNECTION_STRING=""
# The voice: Azure AI Speech, by the resource's full ID, and its region (e.g. uaenorth).
SPEECH_RESOURCE_ID=
SPEECH_REGION=
# Prompt Shields on every question asked: the Azure AI Content Safety (or Foundry) endpoint.
CONTENT_SAFETY_ENDPOINT=

# --- The studio's limits (the defaults) -----------------------------------------------------------
# STUDIO_MAX_STREAMS=8
# STUDIO_DAILY_MODEL_MATCHES=200
# STUDIO_MAX_QUESTIONS=12

# --- Owner only: recording the demo video (not needed to run HUDHUD) ------------------------------
# The OBS WebSocket password, read by scripts/director.py and the OBS MCP server.
OBS_MCP_PASSWORD=
